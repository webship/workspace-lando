{
  "name": "@webship.co/workspace-lando",
  "version": "1.0.0-alpha1",
  "description": "Lando for Webship Workspace: the LANDO menu on every project with a .lando.yml (start, stop, restart, rebuild, info, logs, ssh, destroy), the up/down caption, the proxy URL as the site link. A runtime of @webship.co/workspace-container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-lando.git"
  },
  "files": [
    "dist/src",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "lando",
    "label": "Lando",
    "typeActions": {
      "lando": [
        "sites",
        "code"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "features": [
      "features/lando.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.lando.yaml"
      ],
      "hostMounts": [
        "~/.lando"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-container": "^1.0.0-alpha1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-alpha1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
